{
  "name": "islam",
  "compatibility_date": "2026-10-02",
  "main": "worker/index.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "islam.house", "custom_domain": true },
    { "pattern": "www.islam.house", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/brand/*",
      "!/adhan/*",
      "!/icons/*",
      "!/sw.js",
      "!/workbox-*",
      "!/registerSW.js",
      "!/manifest.webmanifest",
      "!/favicon*",
      "!/apple_touch_icon.png",
      "!/logo.png",
      "!/og_image.png"
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "SEO_RICH_HTML": "1",
    "SEO_CITY_PAGES": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": false
    }
  }
}

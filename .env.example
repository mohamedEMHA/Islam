# Server-side secrets for Vite/Wrangler proxies (NEVER use VITE_ prefix for these).
# Local Vite proxy reads them from this file / .env.local.
# Production: npx wrangler secret put SUNNAH_API_KEY | UMMAH_API_KEY

# Optional: Sunnah.com hadith API (books, chapters, isnad, references)
# Request a key at https://github.com/sunnah-com/api/issues
SUNNAH_API_KEY=

# Optional: UmmahAPI (Zakat, Baby Names, daily feed)
UMMAH_API_KEY=

# Optional: public site URL for canonical / Open Graph (no trailing slash)
VITE_SITE_URL=https://islam.house

# Optional: Cloudflare Web Analytics token (loaded only after cookie consent)
VITE_CF_ANALYTICS_TOKEN=
